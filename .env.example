# Distributed Claude Agents - Environment Configuration

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=dca
DB_USER=dca
DB_PASSWORD=dca_secret

# Redis
REDIS_URL=redis://redis:6379

# Orchestrator
PORT=3001
WORKSPACE_ROOT=/workspace

# Agents
AGENT_ROLES=all

# Optional: LLM Backend (local-first, only used if configured)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3
