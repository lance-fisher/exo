{
  "name": "@sovereign-console/local-agent",
  "version": "1.0.0",
  "description": "Sovereign Operator Console local agent — runs as a Windows service, connects outbound to broker via mTLS WebSocket, invokes Claude Code for AI-assisted development tasks.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "install-service": "powershell -ExecutionPolicy Bypass -File scripts/install-service.ps1",
    "uninstall-service": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-service.ps1",
    "generate-certs": "powershell -ExecutionPolicy Bypass -File scripts/generate-certs.ps1",
    "lint": "tsc --noEmit",
    "test": "npx jest --passWithNoTests"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "diff": "^7.0.0",
    "node-forge": "^1.3.1",
    "tiktoken": "^1.0.18",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.12.0",
    "@types/node-forge": "^1.3.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
