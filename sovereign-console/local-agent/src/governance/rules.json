{
  "protected_paths": [
    ".env*",
    "*.key",
    "*.pem",
    "*.p12",
    "*.pfx",
    ".git/config",
    ".git/credentials",
    "credentials*",
    "**/secrets/**",
    "**/node_modules/**",
    "**/.ssh/**",
    "**/id_rsa*",
    "**/id_ed25519*",
    "**/.aws/**",
    "**/.azure/**",
    "**/serviceAccountKey*",
    "**/.npmrc",
    "**/.pypirc"
  ],
  "allowed_operations": [
    "file_read",
    "file_browse",
    "file_diff",
    "file_write",
    "task",
    "project_list",
    "status"
  ],
  "max_file_read_size_bytes": 1048576,
  "max_file_write_size_bytes": 524288,
  "max_tasks_per_session": 20,
  "max_tokens_per_task": 50000,
  "rate_limit_per_minute": 30,
  "require_approval_for": [
    "file_write",
    "task"
  ]
}
