# =============================================================================
# Sovereign Operator Console — Broker Environment Variables
# =============================================================================

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql://sovereign:changeme@localhost:5432/sovereign_console

# --- Redis ---
# Redis connection string for session store and command queue
REDIS_URL=redis://localhost:6379/0

# --- Server ---
# Port and host the broker listens on (behind NGINX)
BROKER_PORT=3100
BROKER_HOST=127.0.0.1

# --- Secrets ---
# JWT signing secret (min 64 chars, generate with: openssl rand -hex 32)
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32

# Session encryption secret (min 32 chars)
SESSION_SECRET=changeme-generate-with-openssl-rand-hex-16

# --- WebAuthn / Passkey ---
# Relying Party ID — must match the domain the console is served from
WEBAUTHN_RP_ID=ops.lancewfisher.com

# Human-readable RP name shown during passkey ceremonies
WEBAUTHN_RP_NAME=Sovereign Console

# Origin for WebAuthn verification (must include scheme, no trailing slash)
WEBAUTHN_ORIGIN=https://ops.lancewfisher.com

# --- Agent mTLS ---
# Path to the CA certificate that signed agent certs
AGENT_MTLS_CA_CERT=/etc/sovereign/certs/agent-ca.pem

# Broker's own mTLS cert and key for agent connections
AGENT_MTLS_CERT=/etc/sovereign/certs/broker.pem
AGENT_MTLS_KEY=/etc/sovereign/certs/broker-key.pem

# --- TOTP ---
# AES-256 key for encrypting TOTP secrets at rest (32 bytes hex)
TOTP_ENCRYPTION_KEY=changeme-generate-with-openssl-rand-hex-32

# --- Approval Tokens ---
# TTL for write-operation approval tokens (seconds)
APPROVAL_TOKEN_TTL_WRITE=120

# TTL for dangerous-operation approval tokens (seconds)
APPROVAL_TOKEN_TTL_DANGEROUS=60

# --- Command Queue ---
# Maximum time a queued command waits for agent to come online (seconds)
AGENT_QUEUE_TTL_SECONDS=300

# --- Claude Code Limits ---
# Maximum tokens per individual task
CLAUDE_MAX_TOKENS_PER_TASK=50000

# Maximum concurrent tasks per session
CLAUDE_MAX_TASKS_PER_SESSION=20

# Daily spend threshold in USD — broker warns operator when exceeded
CLAUDE_DAILY_SPEND_THRESHOLD=25.00

# --- CORS ---
# Allowed origin for CORS (must match console UI domain)
CORS_ORIGIN=https://ops.lancewfisher.com

# --- Logging ---
# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
