{
  "project": "exo",
  "ecosystem_root": "D:\\ProjectsHome",
  "project_path": "D:\\ProjectsHome\\exo",
  "repository": "https://github.com/lance-fisher/exo.git",
  "baseline_branch": "claude/baseline-branch-architecture-Up7HI",
  "main_branch": "main",
  "platform_support": ["windows", "linux", "macos"],
  "portability": {
    "all_paths_relative": true,
    "no_hardcoded_absolute_paths": true,
    "cross_platform_scripts": true,
    "requires": ["python3", "git"]
  },
  "governance_files": {
    "project_entrypoint": "CLAUDE.md",
    "baseline_system": ".baseline/BASELINE_SYSTEM.md",
    "branching_policy": ".baseline/BRANCHING_POLICY.md",
    "risk_tier_model": ".baseline/RISK_TIER_MODEL.md",
    "inheritance_rules": ".baseline/SYSTEM_INHERITANCE_RULES.md",
    "inheritance_map": ".baseline/inheritance_map.json",
    "baseline_manifest": ".baseline/baseline_manifest.json",
    "branch_creation_guide": ".baseline/BRANCH_CREATION_GUIDE.md",
    "git_policy": ".baseline/GIT_BRANCHING_POLICY.md",
    "session_entrypoint": ".baseline/CLAUDE_CODE_ENTRYPOINT.md",
    "deployment_guide": ".baseline/LOCAL_MACHINE_DEPLOYMENT.md"
  },
  "templates": {
    "branch_identity": ".baseline/templates/BRANCH_IDENTITY_TEMPLATE.md",
    "branch_manifest": ".baseline/templates/branch_manifest_template.json",
    "branch_rules": ".baseline/templates/BRANCH_RULES_TEMPLATE.md",
    "elevated_manifest": ".baseline/elevated/elevated_branch_manifest_template.json"
  },
  "scripts": {
    "create_branch": ".baseline/scripts/create_branch.py"
  },
  "ecosystem_integration": {
    "parent_governance_compatible": true,
    "parent_governance_authoritative": true,
    "self_contained": true,
    "subordinate_to_root_governance": true,
    "root_governance_rules": {
      "never_alter": true,
      "never_overwrite": true,
      "never_minimize": true,
      "never_replace": true,
      "additive_only": true,
      "additive_scope": "security, privacy, and protection of data and personal information including local device data",
      "precedence": "root > project > branch"
    },
    "notes": "This project's governance is subordinate to the established root governance at D:\\ProjectsHome. Root governance files are authoritative and must never be altered — only added to for enhanced security and privacy."
  }
}
